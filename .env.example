IMAGE_NAMESPACE=camilomoscoso
LAB_VERSION=latest
RELEASE_VERSION=local
GIT_SHA=local
TARGET_SCHEMA_VERSION=latest
CHECK_HOST_PORT=8080

# Puertos expuestos al host
SQL_HOST_PORT=1433
MONGO_HOST_PORT=27017

# Credenciales de SQL Server
